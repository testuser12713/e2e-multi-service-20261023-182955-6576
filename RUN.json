{
  "runcontract": 1,
  "services": [
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "main.py"
      ],
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ],
      "env": {
        "DATABASE_PATH": {
          "dev": "../data/jobs.db"
        }
      }
    },
    {
      "name": "api",
      "dir": "api",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "health": {
        "path": "/health",
        "expect_status": [
          200
        ]
      },
      "env": {
        "DATABASE_PATH": {
          "dev": "../data/jobs.db"
        },
        "CORS_ORIGINS": {
          "dev": "${service:web.origin}"
        }
      },
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ]
    }
  ]
}
