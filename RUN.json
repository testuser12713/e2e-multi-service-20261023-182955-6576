{
  "runcontract": 1,
  "services": [
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "main.py"
      ],
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ],
      "env": {
        "DATABASE_PATH": {
          "dev": "../data/jobs.db"
        }
      }
    },
    {
      "name": "api",
      "dir": "api",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "health": {
        "path": "/health",
        "expect_status": [
          200
        ]
      },
      "env": {
        "DATABASE_PATH": {
          "dev": "../data/jobs.db"
        },
        "CORS_ORIGINS": {
          "dev": "${service:web.origin}"
        }
      },
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ]
    },
    {
      "name": "web",
      "dir": "web",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}",
        "--strictPort"
      ],
      "port": 5173,
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "ready_timeout_s": 60,
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    }
  ]
}
