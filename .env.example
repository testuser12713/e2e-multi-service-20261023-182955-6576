# Configuration of the job-processing product.
# Copy this file to .env (git-ignored) and adjust it; ./dev.sh reads it.
# None of these values is a secret, and every one has a working default.

# SQLite file shared by API and worker. A relative path is resolved inside api/ and
# worker/ (each service runs in its own directory), so this names <repo>/data/jobs.db
# for both. The API creates the directory and the schema on start.
DATABASE_PATH=../data/jobs.db

# Comma-separated origins the API allows via CORS. Explicit origins only, never "*".
# Unset, the API allows only the local Vite dev server http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Base URL of the API, used by the web frontend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Seconds the worker waits before looking again when no job is pending.
WORKER_POLL_INTERVAL=1

# Ports ./dev.sh starts the API and the frontend on.
API_PORT=8000
WEB_PORT=5173
